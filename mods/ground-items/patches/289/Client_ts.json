   "replace": [
    "        return 0;",
    "    }",
    "    // lclite:ground-items",
    "    /// custom (lclite \"ground-items\" mod): ground item labels — RuneLite's Ground Items.",
    "    /// Drawn at the END of entityOverlays(): the areaGame buffer is already bound there",
    "    /// (the same ride as the true tile's) and otherOverlays() still composites",
    "    /// the interfaces over it afterwards. A label is placed by the engine's OWN world",
    "    /// projection (getOverlayPos — the one entity names and true-tile use)",
    "    /// and culled by RuneLite's own 2500-local-unit cutoff, so walls and roofs do not",
    "    /// hide a label; RuneLite's labels behave the same way.",
    "    /// While Alt is held every item is labelled and each label carries RuneLite's two",
    "    /// list boxes; the click that lands on one is consumed at the top of mouseLoop()",
    "    /// (groundItemsAltClick) instead of walking or opening the menu. Every decision here",
    "    /// is pure and lives in GroundItems.ts.",
    "    private giBoxX: Int32Array = new Int32Array(GI_MAX_BOXES);",
    "    private giBoxY: Int32Array = new Int32Array(GI_MAX_BOXES);",
    "    private giBoxW: Int32Array = new Int32Array(GI_MAX_BOXES);",
    "    private giBoxH: Int32Array = new Int32Array(GI_MAX_BOXES);",
    "    private giBoxKind: Int32Array = new Int32Array(GI_MAX_BOXES);",
    "    private giBoxName: string[] = new Array<string>(GI_MAX_BOXES).fill('');",
    "    private giBoxCount: number = 0;",
    "",
    "    /// custom (lclite \"ground-items\" mod): record a label hit box for this frame. The",
    "    /// boxes are in the areaGame buffer's pixels, which is why the click that tests them",
    "    /// subtracts the same (4, 4) composite offset the engine uses for Model.mouseX/Y.",
    "    private giBoxAdd(x: number, y: number, w: number, h: number, kind: number, name: string): void {",
    "        if (this.giBoxCount >= GI_MAX_BOXES) {",
    "            return;",
    "        }",
    "",
    "        const i: number = this.giBoxCount++;",
    "        this.giBoxX[i] = x;",
    "        this.giBoxY[i] = y;",
    "        this.giBoxW[i] = w;",
    "        this.giBoxH[i] = h;",
    "        this.giBoxKind[i] = kind;",
    "        this.giBoxName[i] = name;",
    "    }",
    "",
    "    private groundItemsDraw(): void {",
    "        this.giBoxCount = 0;",
    "        giTrackAlt();",
    "",
    "        const player: ClientPlayer | null = this.localPlayer;",
    "        if (!player || !this.ingame) {",
    "            return;",
    "        }",
    "",
    "        // this mod's own keys, read per frame at its own hook (hard rule 5)",
    "        const s = giSettings(k => localStorage.getItem(k));",
    "        if (!s.on) {",
    "            return;",
    "        }",
    "",
    "        // ground items only ever exist on the level the client is drawing: showObject()",
    "        // files every ClientObj list under minusedlevel",
    "        const font: PixFont | null = this.p11;",
    "        const objects: (LinkList<ClientObj> | null)[][] | undefined = this.groundObj[this.minusedlevel];",
    "        if (!font || !objects) {",
    "            return;",
    "        }",
    "",
    "        const alt: boolean = giAltHeld();",
    "        const mouseX: number = this.mouseX - 4;",
    "        const mouseY: number = this.mouseY - 4;",
    "        const rowH: number = (font.height | 0) + 4;",
    "        // ±21 tiles around the player covers RuneLite's own label distance with room to",
    "        // spare, so the scan never walks the whole 104x104 build area",
    "        const fromX: number = Math.max(0, (player.x >> 7) - 21);",
    "        const toX: number = Math.min(BuildArea.SIZE - 1, (player.x >> 7) + 21);",
    "        const fromZ: number = Math.max(0, (player.z >> 7) - 21);",
    "        const toZ: number = Math.min(BuildArea.SIZE - 1, (player.z >> 7) + 21);",
    "",
    "        for (let x: number = fromX; x <= toX; x++) {",
    "            const column: (LinkList<ClientObj> | null)[] = objects[x];",
    "            if (!column) {",
    "                continue;",
    "            }",
    "",
    "            for (let z: number = fromZ; z <= toZ; z++) {",
    "                const list: LinkList<ClientObj> | null = column[z];",
    "                if (!list) {",
    "                    continue;",
    "                }",
    "",
    "                const centreX: number = (x << 7) + 64;",
    "                const centreZ: number = (z << 7) + 64;",
    "                if (!giDistanceOk(centreX - player.x, centreZ - player.z)) {",
    "                    continue;",
    "                }",
    "",
    "                this.getOverlayPos(centreX, centreZ, GI_OFFSET_Z);",
    "                if (this.projectX <= -1 || this.projectY <= -1) {",
    "                    continue;",
    "                }",
    "",
    "                const tileX: number = this.projectX;",
    "                const tileY: number = this.projectY;",
    "",
    "                let row: number = 0;",
    "                for (let obj: ClientObj | null = list.head(); obj !== null && row < GI_MAX_STACK; obj = list.next()) {",
    "                    const type: ObjType = ObjType.list(obj.id);",
    "                    const name: string | null = type.name;",
    "                    if (!name) {",
    "                        continue;",
    "                    }",
    "",
    "                    const ha: number = giHaValue(type.cost);",
    "                    const kind: number = giClassify(name, ha, s.shownCsv, s.hiddenCsv, s.minValue);",
    "                    if (kind === GI_HIDDEN && !alt) {",
    "                        continue;",
    "                    }",
    "",
    "                    const text: string = giLabel(name, obj.count, ha, s.showValue);",
    "                    const rgb: number = kind === GI_LISTED ? s.highlightColor : kind === GI_HIDDEN ? s.hiddenColor : s.color;",
    "                    const width: number = font.stringWid(text);",
    "                    const textX: number = tileX - (width >> 1);",
    "                    const textY: number = tileY - row * GI_STRING_GAP;",
    "                    row++;",
    "",
    "                    // the 2004 shadow: one black copy under a coloured one",
    "                    if (textY > 4 && textY < 334 && textX + width > 0 && textX < 512) {",
    "                        font.drawString(text, textX + 1, textY + 1, Colour.BLACK);",
    "                        font.drawString(text, textX, textY, rgb);",
    "                    }",
    "",
    "                    if (!alt || this.giBoxCount + 3 > GI_MAX_BOXES) {",
    "                        continue;",
    "                    }",
    "",
    "                    // RuneLite's Alt-held affordance: [-] hides the item, [+] shows it,",
    "                    // filled while the item is on that list, red/green under the cursor.",
    "                    const boxY: number = textY - ((GI_BOX + rowH) >> 1);",
    "                    const hideX: number = textX + width + 2;",
    "                    const showX: number = hideX + GI_BOX + 2;",
    "                    this.giBoxAdd(textX - 2, textY - rowH - 2, width + 4, rowH + 4, 1, name);",
    "",
    "                    if (showX + GI_BOX > 512 || boxY < 0 || boxY + GI_BOX > 334) {",
    "                        continue;",
    "                    }",
    "",
    "                    this.giDrawBox(hideX, boxY, 2, kind === GI_HIDDEN, name, mouseX, mouseY, Colour.RED, rgb);",
    "                    this.giDrawBox(showX, boxY, 3, kind === GI_LISTED, name, mouseX, mouseY, Colour.GREEN, rgb);",
    "                }",
    "            }",
    "        }",
    "    }",
    "",
    "    private giDrawBox(x: number, y: number, kind: number, filled: boolean, name: string, mouseX: number, mouseY: number, hoverRgb: number, rgb: number): void {",
    "        const over: boolean = mouseX >= x && mouseX < x + GI_BOX && mouseY >= y && mouseY < y + GI_BOX;",
    "        const colour: number = over ? hoverRgb : rgb;",
    "",
    "        Pix2D.fillRect(x + 1, y + 1, GI_BOX, GI_BOX, Colour.BLACK);",
    "        Pix2D.drawRect(x, y, GI_BOX, GI_BOX, colour);",
    "        if (filled) {",
    "            Pix2D.fillRect(x + 1, y + 1, GI_BOX - 2, GI_BOX - 2, colour);",
    "        }",
    "",
    "        // a minus on both boxes, a plus on the show box only (RuneLite's drawRectangle)",
    "        Pix2D.hline(x + 2, y + (GI_BOX >> 1), GI_BOX - 3, Colour.WHITE);",
    "        if (kind === 3) {",
    "            Pix2D.vline(x + (GI_BOX >> 1), y + 2, GI_BOX - 3, Colour.WHITE);",
    "        }",
    "",
    "        this.giBoxAdd(x, y, GI_BOX, GI_BOX, kind, name);",
    "    }",
    "",
    "    /// custom (lclite \"ground-items\" mod): consume a click that landed on a label while",
    "    /// Alt is held — left click on the label or its [+] box shows the item, the [-] box",
    "    /// hides it, a right click on the label hides it (RuneLite's own mouse adapter).",
    "    /// Everything else falls through untouched, so Alt+click still walks/takes normally.",
    "    private groundItemsAltClick(): boolean {",
    "        if (this.giBoxCount === 0 || this.mouseClickButton === 0 || this.isMenuOpen || !giAltHeld()) {",
    "            return false;",
    "        }",
    "",
    "        const hit: number = giHit(this.giBoxX, this.giBoxY, this.giBoxW, this.giBoxH, this.giBoxCount, this.mouseClickX - 4, this.mouseClickY - 4);",
    "        if (hit === -1) {",
    "            return false;",
    "        }",
    "",
    "        const name: string = this.giBoxName[hit];",
    "        if (!name) {",
    "            return false;",
    "        }",
    "",
    "        const kind: number = this.giBoxKind[hit];",
    "        const hide: boolean = kind === 2 || (kind !== 3 && this.mouseClickButton === 2);",
    "        const key: string = hide ? 'groundItemsHidden' : 'groundItemsShown';",
    "        const other: string = hide ? 'groundItemsShown' : 'groundItemsHidden';",
    "",
    "        // RuneLite's updateList(): toggle the clicked list and drop the name from the",
    "        // other one, so an item can never be on both",
    "        const current: string | null = localStorage.getItem(key);",
    "        const listed: boolean = giListHas(current, name);",
    "        localStorage.setItem(key, giListEdit(current, name, !listed));",
    "        if (!listed) {",
    "            localStorage.setItem(other, giListEdit(localStorage.getItem(other), name, false));",
    "        }",
    "",
    "        this.mouseClickButton = 0;",
    "        return true;",
    "    }",
    "    // lclite:ground-items",
    "",
    "    private mapBuild(): void {"
